---
import { work, pad } from '../data/content';
---

<section id="work" class="px-[clamp(20px,4vw,56px)] pt-[clamp(72px,9vw,128px)] pb-[clamp(56px,7vw,96px)]">
  <div class="mb-10 flex flex-wrap items-end justify-between gap-4">
    <h2 class="display text-[clamp(56px,9vw,128px)] leading-[0.85]">
      Selected<br /><span class="font-serif font-normal text-accent normal-case italic font-stretch-100%">work</span>
    </h2>
    <div class="max-w-[260px] font-mono text-xs text-muted">
      Tap a row to open it. Production apps, client platforms and my own products.
    </div>
  </div>

  <div class="border-t border-line-strong" data-accordion>
    {
      work.map((w, i) => {
        const open = i === 0;
        return (
          <div class="border-b border-line-strong">
            <button
              type="button"
              aria-expanded={open ? 'true' : 'false'}
              aria-controls={`work-${i}`}
              class="group flex min-h-12 w-full cursor-pointer flex-wrap items-baseline gap-x-6 gap-y-2 py-7 text-left"
            >
              <span class="flex-[0_0_48px] font-mono text-[13px] text-accent">{pad(i + 1)}</span>
              <span class="flex-[1_1_320px] text-[clamp(34px,5.4vw,76px)] leading-[0.95] font-extrabold uppercase transition-transform duration-[350ms] ease-[cubic-bezier(.2,.7,.2,1)] font-stretch-70% group-hover:translate-x-3.5">
                {w.title}
              </span>
              <span class="flex-[0_1_240px] font-mono text-xs tracking-[0.04em] text-muted uppercase">{w.kind}</span>
              <span class="flex-[0_0_32px] text-right font-mono text-[28px] after:content-['+'] group-aria-expanded:after:content-['−']" />
            </button>
            <div
              id={`work-${i}`}
              hidden={!open}
              class="flex flex-wrap gap-x-14 gap-y-6 pb-10 sm:pl-[72px]"
            >
              <div class="flex flex-[2_1_420px] flex-col gap-3.5">
                {w.points.map((p) => (
                  <p class="text-[17px] leading-[1.6] text-[#d6d2c9]">{p}</p>
                ))}
              </div>
              <div class="flex flex-[1_1_220px] flex-wrap content-start gap-1.5">
                {w.stack.map((t) => (
                  <span class="border border-line-strong px-2.5 py-1.5 font-mono text-[11px] tracking-[0.03em] uppercase">
                    {t}
                  </span>
                ))}
              </div>
            </div>
          </div>
        );
      })
    }
  </div>
</section>

<script>
  const root = document.querySelector('[data-accordion]');
  const buttons = root ? [...root.querySelectorAll<HTMLButtonElement>('button[aria-controls]')] : [];

  for (const btn of buttons) {
    btn.addEventListener('click', () => {
      const willOpen = btn.getAttribute('aria-expanded') !== 'true';
      for (const b of buttons) {
        const open = b === btn && willOpen;
        b.setAttribute('aria-expanded', String(open));
        document.getElementById(b.getAttribute('aria-controls')!)!.hidden = !open;
      }
    });
  }
</script>
