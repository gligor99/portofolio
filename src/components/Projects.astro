---
import SectionLabel from "@/components/SectionLabel.astro";
import { projects } from "@/data/site";
---

<section id="projects" class="border-b border-border py-[52px]">
  <SectionLabel label="Projects" />

  <div class="flex flex-col gap-3.5">
      {
        projects.map((project) => (
          <article class="group relative border border-border px-7 py-7 overflow-hidden transition-colors duration-200 hover:border-border-hi">
            <!-- Animated left accent bar -->
            <span
              class="absolute top-0 left-0 w-[3px] h-full bg-accent origin-bottom scale-y-0 transition-transform duration-300 group-hover:scale-y-100"
              aria-hidden="true"
            />

            <div class="flex items-start justify-between gap-3 mb-2.5">
              <div>
                <p class="font-display font-bold text-[18px] text-text mb-1">{project.name}</p>
                <div class="flex items-center gap-2">
                  <p class="font-mono text-[10px] tracking-[0.1em] text-text-faint">{project.type}</p>
                  {project.status && (
                    <span class="font-mono text-[10px] tracking-[0.08em] text-text-faint border border-border-hi/60 bg-background/40 px-2 py-0.5">
                      {project.status}
                    </span>
                  )}
                </div>
              </div>

              {project.url && (
                <a
                  href={project.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`Visit ${project.name}`}
                  class="text-text-faint mt-1 shrink-0 transition-colors duration-200 hover:text-accent"
                >
                  <svg class="w-3.5 h-3.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                    <path d="M3 13L13 3M13 3H7M13 3v6" />
                  </svg>
                </a>
              )}
            </div>

            <!-- Tags -->
            <div class="flex flex-wrap gap-1.5 mb-3.5">
              {project.tags.map((tag) => (
                <span class="font-mono text-[10px] tracking-[0.06em] text-text-faint border border-border px-2 py-0.5">
                  {tag}
                </span>
              ))}
            </div>

            <p class="text-sm text-text-dim leading-[1.7]">{project.description}</p>
          </article>
        ))
      }

    <!-- Sneak peek card -->
    <article class="group relative border border-border px-7 py-7 overflow-hidden">
      <span class="absolute inset-0 bg-background/40 backdrop-blur-md" aria-hidden="true" />
      <span class="absolute inset-0 bg-gradient-to-br from-accent/10 via-transparent to-transparent" aria-hidden="true" />

      <div class="relative">
        <div class="flex items-start justify-between gap-3 mb-2.5">
          <div>
            <!-- <p class="font-display font-bold text-[18px] text-text/70 mb-1">Project sneak peek</p> -->
            <p class="font-mono text-[10px] tracking-[0.1em] text-text-faint">COMING SOON</p>
          </div>
        </div>

        <div class="flex flex-wrap gap-1.5 mb-3.5 opacity-70">
          <span class="font-mono text-[10px] tracking-[0.06em] text-text-faint border border-border px-2 py-0.5">Next</span>
          <span class="font-mono text-[10px] tracking-[0.06em] text-text-faint border border-border px-2 py-0.5">In progress</span>
          <span class="font-mono text-[10px] tracking-[0.06em] text-text-faint border border-border px-2 py-0.5">Details soon</span>
        </div>

        <p class="text-sm text-text-dim/70 leading-[1.7] max-w-[62ch]">
          Coming more soon
        </p>
      </div>
    </article>
  </div>
</section>
