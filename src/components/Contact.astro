---
import { contact } from '../data/content';

const link = 'inline-flex min-h-11 items-center';
---

<section id="contact" class="flex flex-col gap-9 px-[clamp(20px,4vw,56px)] pt-[clamp(80px,11vw,160px)] pb-10">
  <div class="font-mono text-[13px] text-muted">// got an app that needs to ship?</div>
  <a
    href={`mailto:${contact.email}`}
    class="display block text-[clamp(64px,14vw,220px)] leading-[0.82] no-underline transition-colors duration-[250ms]"
  >
    Let's<br />build <span class="font-serif font-normal text-accent normal-case italic font-stretch-100%">it</span> →
  </a>
  <div class="flex flex-wrap gap-x-9 gap-y-2 font-mono text-sm">
    <a href={`mailto:${contact.email}`} class={link}>{contact.email}</a>
    <a href={contact.phoneHref} class={link}>{contact.phone}</a>
    <a href={contact.linkedin} class={link}>LinkedIn ↗</a>
    <a href={contact.github} class={link}>GitHub ↗</a>
  </div>
  <footer
    class="mt-[72px] flex flex-wrap justify-between gap-3 border-t border-line pt-5 font-mono text-[11px] tracking-[0.05em] text-muted uppercase"
  >
    <span>© {new Date().getFullYear()} Luka Gligorevic</span>
    <span>Designed &amp; built in Bijeljina</span>
  </footer>
</section>
