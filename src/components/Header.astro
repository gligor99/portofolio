---
const links = [
  { href: '#work', label: 'Work' },
  { href: '#stack', label: 'Stack' },
  { href: '#hire', label: 'Hire me' },
  { href: '#contact', label: 'Contact' },
];
---

<header
  class="flex flex-wrap items-center justify-between gap-x-6 gap-y-3 border-b border-line px-[clamp(20px,4vw,56px)] py-5 font-mono text-xs tracking-[0.04em] text-muted uppercase"
>
  <span class="font-bold text-paper">@gligor99 — Fullstack / Mobile</span>
  <span class="inline-flex items-center gap-2">
    <span class="size-2 rounded-full bg-accent"></span>
    Bijeljina, BiH · <span data-clock>CET</span>
  </span>
  <nav aria-label="Sections" class="flex gap-1">
    {links.map((l) => <a href={l.href} class="px-2.5 py-3 no-underline">{l.label}</a>)}
  </nav>
</header>

<script>
  const el = document.querySelector<HTMLElement>('[data-clock]');
  const fmt = new Intl.DateTimeFormat('en-GB', {
    hour: '2-digit',
    minute: '2-digit',
    timeZone: 'Europe/Sarajevo',
  });
  const tick = () => {
    if (el) el.textContent = fmt.format(new Date());
  };
  tick();
  setInterval(tick, 30_000);
</script>
