---
import Layout from "@/layouts/Layout.astro";
---

<Layout title="404 — Luka Gligorevic" noindex>
  <div class="max-w-content mx-auto px-6 min-h-screen flex flex-col justify-center gap-3">
    <p class="font-mono text-2xs tracking-[0.15em] uppercase text-text-faint">404</p>
    <p class="font-display font-bold text-[32px] text-text">Page not found.</p>
    <a
      href="/"
      class="font-mono text-xs tracking-[0.1em] text-accent mt-2 transition-opacity duration-200 hover:opacity-75"
    >
      ← back home
    </a>
  </div>
</Layout>
